{
  "name": "otya-system-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "validate:config": "node validate-config.mjs",
    "check": "npm run validate:config && npm test && npm run typecheck",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/ensure-admin-session-secret.mjs && opennextjs-cloudflare build && wrangler deploy src/production-router.mjs --config wrangler.toml && node scripts/verify-admin-mfa.mjs",
    "maintenance:edge-csp": "bash scripts/remove-legacy-edge-csp.sh",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.25",
    "prettier": "3.8.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.4",
    "typescript": "5.9.3",
    "wrangler": "4.128.0"
  },
  "overrides": {
    "postcss": "8.5.25"
  }
}
