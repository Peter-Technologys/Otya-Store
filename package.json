    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.4.38",
    "prettier": "^3.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
